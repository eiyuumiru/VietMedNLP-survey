# Copy to .env and replace the sample values locally. Never commit .env.
ICL_API_PROVIDER=
ICL_API_KEY=
# Optional for OpenAI-compatible providers; required for Azure OpenAI.
ICL_API_BASE_URL=
# Required only when ICL_API_PROVIDER=azure-openai.
ICL_API_VERSION=

# A single model identifier, or the four paper profiles for the full batch.
ICL_MODEL=
ICL_MODEL_GPT_4O=
ICL_MODEL_GPT_4_1=
ICL_MODEL_GPT_5_2=
ICL_MODEL_GPT_5_4=

# Local directory containing train/ and test/ CSV subdirectories.
ICL_DATA_ROOT=
