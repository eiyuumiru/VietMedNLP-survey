# Copy to .env and replace every sample value locally. Never commit .env.
LLM_FARM_ENDPOINT=https://example.invalid
LLM_FARM_API_KEY=replace_with_your_api_key
LLM_FARM_CHAT_API_VERSION=replace_with_api_version
LLM_FARM_CHAT_DEPLOYMENT=replace_with_single_experiment_deployment

# Google Drive folder ID or full URL for the authorized ICL data folder.
ICL_DATASET_FOLDER_ID=replace_with_authorized_drive_folder_id

# Gateway deployment names serving the four paper model families.
ICL_DEPLOYMENT_GPT_4O=replace_with_gpt_4o_deployment
ICL_DEPLOYMENT_GPT_4_1=replace_with_gpt_4_1_deployment
ICL_DEPLOYMENT_GPT_5_2=replace_with_gpt_5_2_deployment
ICL_DEPLOYMENT_GPT_5_4=replace_with_gpt_5_4_deployment

# Optional checkpoint source used when resuming a run from a strict 4o folder.
# ICL_DEPLOYMENT_GPT_4O_STRICT=replace_with_strict_gpt_4o_deployment
