# Copy to .env and replace the sample values locally. Never commit .env.
ICL_API_PROVIDER=openai-compatible
ICL_API_KEY=replace_with_your_api_key
# Optional for OpenAI-compatible providers; required for Azure OpenAI.
ICL_API_BASE_URL=
# Required only when ICL_API_PROVIDER=azure-openai.
ICL_API_VERSION=

# A single model identifier, or the four paper profiles for the full batch.
ICL_MODEL=replace_with_single_model_id
ICL_MODEL_GPT_4O=replace_with_gpt_4o_model_or_deployment
ICL_MODEL_GPT_4_1=replace_with_gpt_4_1_model_or_deployment
ICL_MODEL_GPT_5_2=replace_with_gpt_5_2_model_or_deployment
ICL_MODEL_GPT_5_4=replace_with_gpt_5_4_model_or_deployment

# Local directory containing train/ and test/ CSV subdirectories.
ICL_DATA_ROOT=replace_with_local_dataset_root
